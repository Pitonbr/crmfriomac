# ════════════════════════════════════════════════════════════════
#  Friomac CRM Frontend — Dockerfile DEV (hot reload)
# ════════════════════════════════════════════════════════════════

FROM node:20-alpine

RUN corepack enable
WORKDIR /app

# Instala dependências apenas (cache layer estável)
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install || pnpm install

# Volume monta o restante em runtime (compose.dev)
EXPOSE 5173
CMD ["pnpm", "dev", "--host", "0.0.0.0"]
