# ════════════════════════════════════════════════════════════════
#  Friomac CRM — Environment Template
#  Copy to .env and fill values. NEVER commit .env.
# ════════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────
APP_ENV=dev                              # dev | test | production
LOG_LEVEL=info                           # debug | info | warning | error
TAG=latest                               # Imagem Docker (CI/CD seta na release)

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_DB=friomac
POSTGRES_USER=friomac
POSTGRES_PASSWORD=changeme_db
DATABASE_URL=postgresql+asyncpg://friomac:changeme_db@db:5432/friomac

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO ───────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=friomac
MINIO_ROOT_PASSWORD=changeme_minio
MINIO_BUCKET=friomac-anexos
MINIO_USE_SSL=false

# ── Auth (JWT) ──────────────────────────────────────────────────
JWT_SECRET=changeme_64_bytes_random      # openssl rand -hex 32
JWT_ACCESS_TTL=900                       # 15 min
JWT_REFRESH_TTL=604800                   # 7 dias
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false                      # true em produção (HTTPS)
COOKIE_SAMESITE=lax

# ── Tenant default ──────────────────────────────────────────────
TENANT_DEFAULT_SLUG=friomac

# ── Email (Sprint 5) ────────────────────────────────────────────
EMAIL_BACKEND=smtp                       # smtp | sendgrid
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@friomac.ind.br
SENDGRID_API_KEY=

# ── WhatsApp Business (Sprint 5) ────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ── ERP Friomac (Sprint 5) ──────────────────────────────────────
ERP_BASE_URL=
ERP_API_KEY=

# ── Caddy / TLS (Sprint 6) ──────────────────────────────────────
DOMAIN=crm.friomac.local
CF_API_TOKEN=                            # Cloudflare DNS-01 (opcional)
